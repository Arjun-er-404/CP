#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int arr[] = {5, 2, 9, 1, 3};
    int n = 5;

    sort(arr, arr + n);

    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 2, 9, 1, 3};
    int n = 5;

    for(int i = 0; i < n-1; i++) {
        for(int j = 0; j < n-i-1; j++) {
            if(arr[j] > arr[j+1]) {
                swap(arr[j], arr[j+1]);
            }
        }
    }

    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 2, 9, 1, 3};
    int n = 5;

    for(int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;

        while(j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }

    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

#include <iostream>
using namespace std;

int main() {
    int a[] = {1, 2, 3, 4, 5};
    int b[] = {2, 4, 6, 8};
    int n = 5, m = 4;

    int i = 0, j = 0;

    while(i < n && j < m) {
        if(a[i] == b[j]) {
            cout << a[i] << " ";
            i++; j++;
        }
        else if(a[i] < b[j]) i++;
        else j++;
    }
}

