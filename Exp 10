#include <iostream>
using namespace std;

int arr[100], front = -1, rear = -1;

void enqueue(int x) {
    if(rear == 99) return;
    if(front == -1) front = 0;
    arr[++rear] = x;
}

void dequeue() {
    if(front == -1 || front > rear) return;
    cout << "Removed: " << arr[front++] << endl;
}

int main() {
    enqueue(10);
    enqueue(20);
    dequeue();
}

