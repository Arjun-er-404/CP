#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    string s1 = "listen";
    string s2 = "silent";

    sort(s1.begin(), s1.end());
    sort(s2.begin(), s2.end());

    if(s1 == s2)
        cout << "Anagram";
    else
        cout << "Not Anagram";
}

#include <iostream>
using namespace std;

int main() {
    string s = "geeksforgeeks";

    for(int i = 0; i < s.length(); i++) {
        for(int j = i + 1; j < s.length(); j++) {
            if(s[i] == s[j]) {
                cout << "Leftmost repeating: " << s[i];
                return 0;
            }
        }
    }

    cout << -1;
}

